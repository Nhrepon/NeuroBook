{
  "expo": {
    "name": "NeuroBook",
    "slug": "neurobook",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "neurobook",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.neurobook.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan receipts for OCR.",
        "NSFaceIDUsageDescription": "Confirm sensitive actions (R20)."
      }
    },
    "android": {
      "package": "app.neurobook.mobile",
      "permissions": ["CAMERA", "USE_BIOMETRIC", "USE_FINGERPRINT", "INTERNET"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-camera",
      "expo-notifications",
      "expo-local-authentication",
      "expo-sqlite",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
