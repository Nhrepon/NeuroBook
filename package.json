{
  "name": "neurobook",
  "version": "0.1.0",
  "private": true,
  "workspaces": [],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:shared": "vitest run src/shared/tests",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "dev:mobile": "npm -w @neurobook/mobile start",
    "dev:web": "next dev --turbopack"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.0.0",
    "@tanstack/react-query": "^5.59.0",
    "argon2": "^0.41.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-orm": "^0.36.0",
    "i18next": "^23.15.0",
    "jose": "^5.9.0",
    "next": "^16.3.7",
    "postgres": "^3.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^15.0.0",
    "recharts": "^2.13.0",
    "tailwindcss": "^4.0.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "packageManager": "npm@10.9.0"
}
