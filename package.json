{
  "name": "neurobook",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:setup": "npm run --workspace=@neurobook/web db:setup",
    "db:seed": "npm run --workspace=@neurobook/web db:seed",
    "db:chart": "npm run --workspace=@neurobook/web db:chart",
    "db:stock": "npm run --workspace=@neurobook/web db:stock",
    "db:product-codes": "npm run --workspace=@neurobook/web db:product-codes",
    "db:multi-tenant": "npm run --workspace=@neurobook/web db:multi-tenant --",
    "db:sync-names": "npm run --workspace=@neurobook/web db:sync-names --",
    "db:rls": "npm run --workspace=@neurobook/web db:rls",
    "db:studio": "npm run --workspace=@neurobook/web db:studio"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "npm@10.9.0",
  "allowScripts": {
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true
  },
  "dependencies": {
    "tailwindcss": "^4.3.3"
  }
}
