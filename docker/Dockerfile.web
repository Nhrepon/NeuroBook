FROM node:20-alpine AS base
WORKDIR /repo

# Install workspace deps
COPY package*.json ./
COPY tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/web/package.json apps/web/
RUN npm ci

# Build shared
COPY packages/shared packages/shared
RUN npm -w packages/shared build

# Build web
COPY apps/web apps/web
RUN npm -w apps/web build

# Runtime
FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=base /repo/apps/web/.next ./apps/web/.next
COPY --from=base /repo/apps/web/public ./apps/web/public
COPY --from=base /repo/apps/web/package.json ./apps/web/package.json
COPY --from=base /repo/packages/shared ./packages/shared
COPY --from=base /repo/node_modules ./node_modules
WORKDIR /app/apps/web
EXPOSE 3000
CMD ["npx", "next", "start", "-p", "3000"]
