{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "incremental": true,
    "allowJs": false,
    "noEmit": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@neurobook/shared": ["./src/shared/index.ts"],
      "@neurobook/shared/ledger": ["./src/shared/ledger/index.ts"],
      "@neurobook/shared/auth": ["./src/shared/auth/index.ts"],
      "@neurobook/shared/format": ["./src/shared/format/index.ts"],
      "@neurobook/shared/env": ["./src/shared/env.ts"]
    }
  },
  "include": ["next-env.d.ts", "src/**/*", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
