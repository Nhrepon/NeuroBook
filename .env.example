# Owner connection: migrations, seeding, and auth lookup only.
DATABASE_URL=postgres://neurobook:neurobook@localhost:5432/neurobook

# Restricted runtime role. RLS is enforced for this role; create it with:
#   npm run db:rls --workspace=@neurobook/web
APP_DATABASE_URL=postgres://neurobook_app:neurobook_app@localhost:5432/neurobook

# Optional overrides used by the RLS setup script.
# APP_DB_ROLE=neurobook_app
# APP_DB_PASSWORD=change-me

# Use a 32+ character secret in production.
JWT_SECRET=dev-secret-change-me-please-32-chars

# Mobile app
EXPO_PUBLIC_API_URL=http://localhost:3000
