# NeuroBook environment (§15.5 O5).
# This file documents required keys only. Real values are injected at deploy;
# secrets never belong in the repo. packages/config validates all of these at
# boot and fails loudly if a required key is missing.

# Postgres. In production this must point at a non-superuser role — RLS never
# applies to a SUPERUSER, so the isolation guarantee (R9) would be void.
DATABASE_URL=postgresql://neurobook@127.0.0.1:5432/neurobook

# Sessions, rate limiting (R14). Optional in dev.
REDIS_URL=

# JWT signing keys, RS256 PEM. Generate with:
#   openssl genpkey -algorithm RSA -out jwt.private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -in jwt.private.pem -pubout -out jwt.public.pem
# Rotate by generating a new key and bumping JWT_KID (§15.2).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KID=neurobook-1

# Token lifetimes. Access stays short (R13).
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Object storage + transactional email (optional in dev).
STORAGE_BUCKET=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# Phase 2: running inside Electron swaps the DB adapter to local SQLite.
ELECTRON=0

APP_URL=http://localhost:3000
