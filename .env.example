# --- Database ---
DATABASE_URL=postgresql://neurobook:neurobook@localhost:5432/neurobook

# --- Cache / Sessions ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_PRIVATE_KEY_B64=base64-of-pem-dev-keypair
JWT_PUBLIC_KEY_B64=base64-of-pem-dev-keypair
JWT_KID=dev-1
JWT_REFRESH_SECRET=replace-me-different-min-32-bytes
JWT_ISSUER=neurobook
JWT_AUDIENCE=neurobook.web

# --- Storage ---
STORAGE_BUCKET=neurobook-uploads
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345

# --- Email (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=replace-me
EMAIL_FROM="NeuroBook <no-reply@neurobook.app>"

# --- SMS (local BD gateway) ---
SMS_GATEWAY_URL=https://sms.example.com/send
SMS_GATEWAY_KEY=replace-me

# --- Mobile (Expo) ---
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_APP_VERSION=0.1.0

# --- Misc ---
NODE_ENV=development
LOG_LEVEL=info
